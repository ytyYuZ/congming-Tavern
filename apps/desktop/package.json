{
  "name": "@smarttavern/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tauri 2 desktop shell — mounts the apps/web UI with native HTTP capability injected.",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --logLevel warn",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:check": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@smarttavern/core": "workspace:*",
    "@smarttavern/providers": "workspace:*",
    "@smarttavern/schema": "workspace:*",
    "@smarttavern/web": "workspace:*",
    "@tauri-apps/api": "2.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "^8.3.1"
  }
}
