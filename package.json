{
  "name": "smarttavern",
  "version": "0.0.0",
  "private": true,
  "description": "聪明酒馆 SmartTavern — local-first, multi-platform, AI-assisted roleplay & TRPG workbench (SillyTavern data-format compatible).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "biome check . && node tools/scripts/check-dependency-direction.mjs && node tools/scripts/check-i18n-literals.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -b && node tools/scripts/typecheck-tests.mjs",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "check:deps": "node tools/scripts/check-dependency-direction.mjs",
    "check:i18n": "node tools/scripts/check-i18n-literals.mjs",
    "schema:export": "node tools/schema-export/export.mjs",
    "stpack": "node tools/stpack-cli/bin/stpack.mjs",
    "build": "tsc -b --noCheck --noEmit false && pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" build",
    "dev": "pnpm --filter @smarttavern/web dev",
    "start": "pnpm build && pnpm --filter @smarttavern/web preview",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ci:local": "node tools/scripts/run-ci-local.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
