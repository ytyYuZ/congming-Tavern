# SmartTavern — npm compatibility settings.
#
# pnpm 12 does NOT read `cacheDir` / `storeDir` / `allowBuilds` from here: those
# live in pnpm-workspace.yaml. This file only carries the few keys npm and older
# pnpm versions still honour.
#
# Windows/sandboxed hosts: if `pnpm install` fails with
#   ERR_PNPM_STORE_DIR_OPEN_OPERATION_LOCK
#   ... pnpm-store-operation-locks\all-stores.lock 拒绝访问 (os error 5)
# the user-level pnpm directories are not writable. Point them at the workspace
# before running pnpm — see CONTRIBUTING.md §1 (`.local-appdata/` is ignored):
#   $env:LOCALAPPDATA = "$PWD\.local-appdata"; $env:USERPROFILE = $env:LOCALAPPDATA

# Fail an install on a Node version the project does not support (engines says
# >=22.12.0) instead of printing a warning and continuing.
engine-strict=true

#
# Hoisted linker, deliberately: some supported hosts cannot build pnpm's default
# isolated layout (ERR_PNPM_SYMLINK_FAILED [symlinkAllModules] Maximum call stack
# size exceeded), which leaves a half-linked tree where @vitest/utils and friends
# fail to resolve. It has to be a TRACKED setting rather than a flag somebody
# remembers to pass, because pnpm auto-installs when it believes node_modules is
# stale (verify-deps-before-run) and that auto-install would switch the tree back
# to the isolated layout and break it again.
#
# Cost: a hoisted tree is more forgiving about undeclared dependencies. The
# dependency direction is enforced by biome + tools/scripts/check-dependency-direction.mjs,
# not by the linker, so nothing is left unguarded.
#
# Mirrored in pnpm-workspace.yaml as `nodeLinker` because pnpm 12 reads settings
# from there while pnpm 11 reads them from this file.
node-linker=hoisted
