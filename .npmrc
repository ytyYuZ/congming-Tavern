# SmartTavern — npm compatibility settings.
#
# pnpm 12 does NOT read `cacheDir` / `storeDir` / `allowBuilds` from here: those
# live in pnpm-workspace.yaml. This file only carries the few keys npm and older
# pnpm versions still honour.
#
# Windows/sandboxed hosts: if `pnpm install` fails with
#   ERR_PNPM_STORE_DIR_OPEN_OPERATION_LOCK
#   ... pnpm-store-operation-locks\all-stores.lock 拒绝访问 (os error 5)
# the user-level pnpm directories are not writable. Point them at the workspace
# before running pnpm — see CONTRIBUTING.md §1 (`.local-appdata/` is ignored):
#   $env:LOCALAPPDATA = "$PWD\.local-appdata"; $env:USERPROFILE = $env:LOCALAPPDATA

# Fail an install on a Node version the project does not support (engines says
# >=22.12.0) instead of printing a warning and continuing.
engine-strict=true
